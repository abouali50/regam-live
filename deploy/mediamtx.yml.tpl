# REGAM Live - media server (MediaMTX). Generated by install.sh, do not edit by hand.
# Paths, per room (studio_<room>, air_<room>, ...):
#   studio    : the host's mixed picture + sound (published from the studio page)
#   air       : what the audience watches (studio re-encoded to H.264/AAC, served as HLS)
#   guest     : the guest on stage
#   backstage : the host's voice alone, for the guest
logLevel: info

authMethod: internal
authInternalUsers:
  - user: __MTX_USER__
    pass: __MTX_PASS__
    ips: []
    permissions:
      - action: publish
      - action: read
      - action: api
  - user: any
    pass:
    ips: []
    permissions:
      - action: read
        path: "~^air_[a-z0-9-]+$"

api: true
apiAddress: :9997

rtsp: true
rtspTransports: [tcp]
rtspAddress: :8554
rtmp: false
srt: false

hls: true
hlsAddress: :8888
hlsAllowOrigins: ["*"]
# The app is the only HLS client: it proxies the "air" path to viewers with this secret.
hlsCDNSecret: __MTX_PASS__
hlsAlwaysRemux: true
hlsVariant: mpegts
hlsSegmentCount: 7
hlsSegmentDuration: 2s

webrtc: true
webrtcAddress: :8889
webrtcLocalUDPAddress: :8189
webrtcLocalTCPAddress: :8189
webrtcIPsFromInterfaces: false
webrtcAdditionalHosts: [__PUBLIC_IP__]

paths:
  # One set of paths per room; the room's short name is the last part.
  "~^studio_([a-z0-9-]+)$":
    runOnAvailable: >-
      ffmpeg -hide_banner -loglevel warning -rtsp_transport tcp
      -i rtsp://__MTX_USER__:__MTX_PASS__@127.0.0.1:8554/$MTX_PATH
      -vf scale=__W__:__H__:force_original_aspect_ratio=decrease,pad=__W__:__H__:-1:-1,fps=25,format=yuv420p
      -c:v libx264 -preset veryfast -tune zerolatency -g 50 -keyint_min 50 -sc_threshold 0
      -b:v __VBITRATE__ -maxrate __VBITRATE__ -bufsize __VBUF__
      -c:a aac -b:a 128k -ar 48000 -ac 2
      -f rtsp -rtsp_transport tcp rtsp://__MTX_USER__:__MTX_PASS__@127.0.0.1:8554/air_$G1
    runOnAvailableRestart: true
  "~^air_[a-z0-9-]+$":
    # every live is kept as a video file (one file per live, cut every 6 hours)
    record: true
    recordPath: /recordings/%path/%Y-%m-%d_%H-%M-%S-%f
    recordFormat: fmp4
    recordSegmentDuration: 6h
    recordDeleteAfter: 0s
  "~^(guest|backstage)([1-9]|1[0-2])_[a-z0-9-]+$":
