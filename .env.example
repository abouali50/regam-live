# Local chat testing. The VPS installer generates its own .env.
LISTEN_HOST=127.0.0.1
PORT=3000
ADMIN_PASSWORD=
HOST_NAME=REGAM
SITE_TITLE="REGAM Live"
# On a server: the address of the site (https://...), written in the e-mails it sends.
PUBLIC_ORIGIN=
# A long random value (openssl rand -hex 32). Without it, sessions end at every restart.
SECRET=
